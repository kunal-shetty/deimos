8;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;97;48;2;0;95;0m   6 + def test_export_csv(tmp_path):                                                       \u001b[0m \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;97;48;2;0;95;0m   7 +     path = tmp_path / \"out.csv\"                                                      \u001b[0m \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;97;48;2;0;95;0m   8 +     export_csv([{\"name\": \"Hosting\", \"price\": 40.0, \"qty\": 3}], path)                 \u001b[0m \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;97;48;2;0;95;0m   9 +     with open(path) as f:                                                            \u001b[0m \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;97;48;2;0;95;0m  10 +         assert next(csv.DictReader(f))[\"name\"] == \"Hosting\"                          \u001b[0m \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m                                                                                              \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m Do you want to make this edit to tests/test_export.py?                                       \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m                                                                                              \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;95;215;255m\u276f 1. Yes\u001b[0m                                                                                     \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001