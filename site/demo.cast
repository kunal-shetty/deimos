[3.636, "o", "\r\n"]
[3.638, "o", "  Installing Deimos\r\n"]
[3.642, "o", "\r\n"]
[4.092, "o", "  Using Python 3.13.2 at C:\\Python313\\python.exe\r\n"]
[4.136, "o", "  Creating an environment in /c/tmp/demo-home/.deimos/venv\r\n"]
[4.587, "o", "  Downloading and installing Deimos (this can take a minute)\r\n"]
[5.037, "o", "  Linked /c/tmp/demo-home/.local/bin/deimos\r\n"]
[5.487, "o", "\r\n"]
[5.489, "o", "  Installed deimos 0.2.0\r\n"]
[5.49, "o", "\r\n"]
[5.492, "o", "  Add /c/tmp/demo-home/.local/bin to your PATH to run deimos from anywhere.\r\n"]
[5.494, "o", "  Run 'deimos' in any project folder. The first run asks for your Groq API key.\r\n"]
[5.495, "o", "  Update later with 'deimos update'. Uninstall by deleting /c/tmp/demo-home/.deimos and /c/tmp/demo-home/.local/bin/deimos.\r\n"]
