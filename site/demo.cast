[24.044, "o", "\u001b[?2004h\u001b[?1l\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0m  \u001b[0;38;2;255;215;95m\u256d\u2500\u001b[0m \u001b[0;38;2;255;215;95;1mEdit file\u001b[0m \u001b[0;38;2;255;215;95m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;1mUpdate invoice.py with 1 addition and 1 removal\u001b[0m                                              \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;138;138;138m   7   \u001b[0m                                                                                      \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;138;138;138m   8   def apply_discount(amount, percent):\u001b[0m                                                  \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;97;48;2;95;0;0m   9 -     return amount - percent                                                          \u001b[0m \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;97;48;2;0;95;0m   9 +     return amount * percent / 100                                                    \u001b[0m \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;138;138;138m  10   \u001b[0m                                                                                      \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;138;138;138m  11   \u001b[0m                                                                                      \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m                                                                                              \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m Do you want to make this edit to invoice.py?                                                 \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m                                                                                              \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;95;215;255m\u276f 1. Yes\u001b[0m                                                                                     \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;138;138;138m  2. Yes, and don't ask again for file edits this session\u001b[0m                                    \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2502\u001b[0m \u001b[0;38;2;138;138;138m  3. No, and tell Deimos what to do differently\u001b[0m                                              \u001b[0;38;2;255;215;95m\u2502\u001b[0m\r\n\u001b[0m  \u001b[0;38;2;255;215;95m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n\u001b[0m    \u001b[0;38;2;88;88;88m\u2191/\u2193 or 1-3 to choose \u00b7 enter to confirm \u00b7 esc to decline\u001b[60D\u001b[15A\u001b[?7h\u001b[0m\u001b[?12l\u001b[?25h"]
